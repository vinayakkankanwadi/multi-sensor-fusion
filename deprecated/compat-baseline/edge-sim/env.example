# Copy to: capture/env
# Source from each capture/replay script.

# --- Windows host (running the BSI Flex test harness) ---
# IP on the LAN that the Ubuntu host can reach.
SAPIENT_HOST=192.0.2.10

# Ports the reference harness exposes (defaults from app.config):
#   DA Communication Port: SDA listens for ASMs, DMM listens for SDAs
SAPIENT_DA_PORT=14000
#   HDA Tasking Port: DMM listens for downstream tasking link
SAPIENT_TASKING_PORT=12002
#   Optional GUI Port
SAPIENT_GUI_PORT=12003

# --- Local Ubuntu network interface used to capture ---
# Set to the interface that routes to SAPIENT_HOST (check `ip route get $SAPIENT_HOST`).
CAPTURE_IFACE=eth0

# --- Output ---
# Where to land baseline artifacts.
BASELINES_DIR=./baselines

# --- Optional: remote PostgreSQL on the Windows host ---
# Only required if you want Ubuntu to pg_dump the Windows DB directly.
# Otherwise leave commented and rely on pcap-only baselines.
# PGHOST=192.0.2.10
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=password
# PGDATABASE=sapientdb
